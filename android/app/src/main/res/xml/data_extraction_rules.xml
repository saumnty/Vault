<?xml version="1.0" encoding="utf-8"?>
<!--
  F7: nada de la app se respalda en la nube ni se transfiere a otro
  dispositivo (Android 12+). La bóveda cifrada se recupera con el código de
  recuperación + Drive (F9), no con el respaldo del sistema.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
